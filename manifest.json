{
   "action": {
      "default_popup": "popup/popup.html",
      "title": "Prolific get studies automatically"
   },
   "background": {
      "service_worker": "dist/background.js"
   },
   "content_scripts": [ {
      "js": [ "dist/content.js" ],
      "matches": [ "https://app.prolific.com/*" ]
   } ],
   "description": "Google extension for Prolific to notify you when studies are available",
   "host_permissions": [ "https://app.prolific.com/*" ],
   "icons": {
      "128": "imgs/logo.png",
      "16": "imgs/logo.png",
      "48": "imgs/logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Prolific Studies Notifier",
   "permissions": [ "storage", "notifications", "offscreen", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.5.0"
}
